# =============================================
# ClientFacing Stack — Environment Variables
# Copy this to .env and fill in all values
# =============================================

# --- Shared PostgreSQL ---
POSTGRES_USER=cfadmin
POSTGRES_PASSWORD=changeme_postgres

# --- MariaDB (BookStack only) ---
MARIADB_ROOT_PASSWORD=changeme_mariadb_root
MARIADB_PASSWORD=changeme_mariadb

# --- MinIO (shared object storage) ---
MINIO_ROOT_USER=cfminio
MINIO_ROOT_PASSWORD=changeme_minio_min16chars

# --- Chatwoot ---
# Generate: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=

# --- Documenso ---
# Generate: openssl rand -hex 32
DOCUMENSO_NEXTAUTH_SECRET=
# Must be exactly 32 chars: openssl rand -hex 16
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_KEY_SECONDARY=

# --- n8n ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n

# --- Plane ---
# Generate: openssl rand -hex 32
PLANE_SECRET_KEY=
PLANE_ADMIN_PASSWORD=
